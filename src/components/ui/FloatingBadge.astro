---
interface Props {
  line1: string;
  line2: string;
  position: 'left' | 'right';
  accent?: 'blue' | 'teal';
}

const { line1, line2, position, accent = 'blue' } = Astro.props;

const positionClass = position === 'left'
  ? 'absolute top-[15%] -left-[30px]'
  : 'absolute bottom-[20%] -right-[20px]';

const delay = position === 'left' ? '0s' : '1.5s';

const accents = {
  blue: { bg: 'bg-curious-blue-100', stroke: '#0197E3' },
  teal: { bg: 'bg-secondary-100', stroke: '#0F766E' },
};

const { bg, stroke } = accents[accent];
---

<div
  class={`${positionClass} bg-white px-5 py-3.5 rounded-[14px] shadow-elev-3 flex items-center gap-3`}
  style={`animation: float 4s ease-in-out infinite; animation-delay: ${delay};`}
  aria-hidden="true"
>
  <div class={`flex-shrink-0 w-8 h-8 rounded-full ${bg} flex items-center justify-center`}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
  </div>
  <div class="text-[13px] font-bold text-ink-900 leading-tight">
    {line1}<br /><span class="font-medium text-ink-400">{line2}</span>
  </div>
</div>
