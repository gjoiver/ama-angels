---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import SectionHeader from '@ui/SectionHeader.astro';

const lang = getLangFromUrl(Astro.url);
const translation = useTranslations(lang);

const faqs = [
  { q: translation('faq.q1'), a: translation('faq.a1') },
  { q: translation('faq.q2'), a: translation('faq.a2') },
  { q: translation('faq.q3'), a: translation('faq.a3') },
  { q: translation('faq.q4'), a: translation('faq.a4') },
  { q: translation('faq.q5'), a: translation('faq.a5') },
];

const CHEVRON_ICON = `<path d="m6 9 6 6 6-6"/>`;

// Generate FAQPage structured data
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: a,
    },
  })),
};
---

<section id="faq" class="py-24 bg-sand-50">
  <div class="max-w-[720px] mx-auto px-6">
    <SectionHeader
      eyebrow={translation('faq.eyebrow')}
      heading={translation('faq.heading')}
    />

    <div class="flex flex-col gap-3 fade-up">
      {faqs.map(({ q, a }, i) => (
        <details class="group rounded-[20px] bg-white border border-ink-200 shadow-elev-1 transition-all hover:shadow-elev-2 hover:border-curious-blue-200">
          <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-[16px] font-bold text-ink-900 leading-snug list-none [&::-webkit-details-marker]:hidden">
            <span class="pr-4">{q}</span>
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center bg-curious-blue-50 text-curious-blue-700 transition-colors duration-200 group-open:bg-curious-blue-500 group-open:text-white">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-transform duration-200 group-open:rotate-180"
                aria-hidden="true"
                set:html={CHEVRON_ICON}
              />
            </span>
          </summary>
          <div class="px-6 pb-5 text-[15px] leading-[1.7] text-ink-500">
            {a}
          </div>
        </details>
      ))}
    </div>
  </div>

  <!-- FAQ Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
