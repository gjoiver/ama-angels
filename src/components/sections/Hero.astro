---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { buildWhatsappUrl } from '@core/constants/contact';
import Button from '@ui/Button.astro';
import FloatingBadge from '@ui/FloatingBadge.astro';

const lang = getLangFromUrl(Astro.url);
const translation = useTranslations(lang);

const PULSE_ICON = `<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>`;
const CHECK_ICON = `<path d="M20 6 9 17l-5-5"/>`;

const trustItems = [
  translation('hero.trust1'),
  translation('hero.trust2'),
  translation('hero.trust3'),
  translation('hero.trust4'),
];
---

<section id="inicio" class="relative min-h-screen flex items-center pt-[72px] lg:pt-28 overflow-hidden">
  <!-- Warm surface — identity stays blue, the environment breathes -->
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(120% 120% at 12% 0%, #FFFFFF 0%, #F4F1EA 55%, #EAF6FE 100%);"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-[1200px] mx-auto px-6 w-full py-20 lg:py-0">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Contenido -->
      <div class="fade-up text-center lg:text-left">
        <!-- Badge superior con pulso vital -->
        <div
          class="inline-flex items-center gap-2 bg-white text-curious-blue-700 px-4 py-1.5 rounded-full text-[13px] font-semibold mb-6 border border-curious-blue-100 shadow-[0_4px_10px_-4px_rgba(1,151,227,0.2)]"
        >
          <span
            class="w-[7px] h-[7px] rounded-full bg-curious-blue-500"
            style="animation: pulse-dot 1.8s infinite;"
            aria-hidden="true"
          ></span>
          {translation('hero.badge')}
        </div>

        <h1
          class="font-display text-[clamp(40px,5.5vw,60px)] font-extrabold leading-[1.08] text-ink-900 tracking-[-1.5px] mb-6"
        >
          {translation('hero.headingPrefix')}
          <span class="hero-highlight">{translation('hero.headingHighlight')}</span>
        </h1>

        <p class="text-[18px] leading-[1.75] text-ink-500 mb-10 max-w-[500px] mx-auto lg:mx-0">
          {translation('hero.description')}
        </p>

        <div class="flex flex-col items-center lg:items-start gap-3">
          <div class="flex flex-wrap justify-center lg:justify-start gap-4">
            <Button
              href={buildWhatsappUrl(translation('hero.whatsappMessage'))}
              variant="primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              {translation('hero.ctaPrimary')}
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </Button>
            <Button href="#turismo" variant="outline">
              {translation('hero.ctaSecondary')}
            </Button>
          </div>
          <p class="text-[13px] text-ink-400 mt-1">
            {translation('hero.ctaPrimaryMicro')}
          </p>
        </div>
      </div>

      <!-- Visual (oculto en móvil/tablet) -->
      <div
        class="relative hidden lg:flex justify-center items-center fade-up"
        style="animation-delay: 0.2s"
      >
        <!-- Tarjeta principal -->
        <div
          class="w-full max-w-[500px] aspect-[4/3.5] rounded-[24px] flex flex-col items-center justify-center gap-6 relative overflow-hidden shadow-elev-3"
          style="background: linear-gradient(155deg, #DEF1FF 0%, #B6E5FF 100%);"
        >
          <div class="flex flex-col items-center gap-4 z-10">
            <div
              class="w-24 h-24 rounded-full bg-white flex items-center justify-center shadow-elev-3"
            >
              <svg
                width="44"
                height="44"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#0197E3"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={PULSE_ICON}
              />
            </div>
            <p class="font-display font-bold text-[20px] text-curious-blue-700 text-center leading-snug max-w-[20ch]">
              {translation('hero.visualTitle')}
            </p>
          </div>
        </div>

        <FloatingBadge
          line1={translation('hero.badge1.line1')}
          line2={translation('hero.badge1.line2')}
          position="left"
          accent="blue"
        />

        <FloatingBadge
          line1={translation('hero.badge2.line1')}
          line2={translation('hero.badge2.line2')}
          position="right"
          accent="teal"
        />
      </div>
    </div>

    <!-- Trust bar -->
    <div class="mt-16 lg:mt-20 fade-up" style="animation-delay: 0.4s">
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 py-6 px-4 rounded-2xl bg-white/60 border border-ink-200 shadow-elev-1">
        {trustItems.map((item) => (
          <div class="flex items-center gap-2 text-ink-500">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0197E3"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={CHECK_ICON}
            />
            <span class="text-[14px] font-medium">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
